[configuration]

entry_symbol = "sky_atmosphere_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/sky_atmosphere/bin/libskyatmosphere.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/sky_atmosphere/bin/libskyatmosphere.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/sky_atmosphere/bin/libskyatmosphere.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/sky_atmosphere/bin/libskyatmosphere.linux.template_release.x86_64.so"
macos.debug = "res://addons/sky_atmosphere/bin/libskyatmosphere.macos.template_debug.framework"
macos.release = "res://addons/sky_atmosphere/bin/libskyatmosphere.macos.template_release.framework"
